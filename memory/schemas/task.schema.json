{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository task frontmatter",
  "type": "object",
  "required": ["schema_version", "id", "status", "owner", "goal_confirmed_at", "started_at", "updated_at", "base_commit", "owned_paths", "plan", "handoff"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "pattern": "^task-[a-z0-9-]+$" },
    "status": { "type": "string", "enum": ["planned", "in-progress", "blocked", "completed"] },
    "owner": { "type": "string", "minLength": 1 },
    "goal_confirmed_at": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "owned_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "plan": { "type": ["string", "null"] },
    "handoff": { "type": ["string", "null"] }
  }
}
