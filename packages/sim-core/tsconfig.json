{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": [],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
